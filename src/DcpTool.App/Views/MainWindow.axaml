<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DcpTool.App.ViewModels"
        xmlns:l="using:DcpTool.App.Localisation"
        xmlns:v="using:DcpTool.App.Views"
        xmlns:c="using:DcpTool.App.Views.Controls"
        x:Class="DcpTool.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}" Width="1366" Height="768" MinWidth="1024" MinHeight="600"
        Icon="avares://DcpTool/icon.ico"
        DragDrop.AllowDrop="True">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDcpCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- The Add area: a drop target, so its frame is dashed. Open step: accent soft fill and accent dashes. -->
    <Style Selector="Rectangle.addFrame">
      <Setter Property="Stroke" Value="{StaticResource Grey400}" />
      <Setter Property="Fill" Value="{StaticResource Sheet}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="3,2" />
      <Setter Property="RadiusX" Value="10" />
      <Setter Property="RadiusY" Value="10" />
    </Style>
    <Style Selector="Panel.addCard:pointerover Rectangle.addFrame">
      <Setter Property="Stroke" Value="{StaticResource Accent}" />
      <Setter Property="Fill" Value="{StaticResource Grey50}" />
    </Style>
    <Style Selector="Panel.addCard.current Rectangle.addFrame">
      <Setter Property="Stroke" Value="{StaticResource Accent}" />
      <Setter Property="Fill" Value="{StaticResource AccentSoft}" />
    </Style>
    <Style Selector="Rectangle.dropFrame">
      <Setter Property="Stroke" Value="{StaticResource Accent}" />
      <Setter Property="Fill" Value="{StaticResource AccentDrop}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="RadiusX" Value="10" />
      <Setter Property="RadiusY" Value="10" />
    </Style>
    <Style Selector="Panel.addCard c|LineIcon.areaIcon">
      <Setter Property="Foreground" Value="{StaticResource Grey600}" />
    </Style>
    <Style Selector="Panel.addCard:pointerover c|LineIcon.areaIcon, Panel.addCard.current c|LineIcon.areaIcon">
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <!-- The Export area: a place to go, so its frame is solid -->
    <Style Selector="Button.exportCard">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.exportCard:pointerover">
      <Setter Property="Background" Value="{StaticResource Grey50}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey600}" />
    </Style>
    <Style Selector="Button.exportCard.current">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.exportCard c|LineIcon.areaIcon">
      <Setter Property="Foreground" Value="{StaticResource Grey600}" />
    </Style>
    <Style Selector="Button.exportCard:pointerover c|LineIcon.areaIcon, Button.exportCard.current c|LineIcon.areaIcon">
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <!-- "Alle Felder": the chevron turns while the fields are folded out -->
    <Style Selector="Button.stripToggle.expanded /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>
    <Style Selector="Button.stripToggle.expanded c|LineIcon">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <!-- The save split button: two secondary buttons that share one outline -->
    <Style Selector="Button.splitMain">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
      <Setter Property="Padding" Value="12,0,14,0" />
    </Style>
    <Style Selector="Button.splitMore">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Margin" Value="-1,0,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.splitMore:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>
  </Window.Styles>

  <Panel>
    <Grid ColumnDefinitions="Auto,*">
      <!-- Step 1: the drawer -->
      <v:DrawerView Grid.Column="0" Width="256" IsVisible="{Binding ShowDrawer}" />

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
        <!-- The programme strip: the three fields that change every episode are always editable -->
        <Border Grid.Row="0" Height="64" Background="{StaticResource Sheet}" BorderBrush="{StaticResource Grey300}" BorderThickness="0,0,0,1"
                Padding="12,0,16,0">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
            <Button Classes="icon" Command="{Binding ToggleDrawerCommand}" ToolTip.Tip="{l:Tr Strip_ToggleDrawer}"
                    AutomationProperties.Name="{l:Tr Strip_ToggleDrawer}">
              <c:LineIcon Width="18" Height="18" StrokeThickness="1.75" Data="{StaticResource Icon.PanelLeft}" />
            </Button>
            <Rectangle Grid.Column="1" Width="1" Height="32" Fill="{StaticResource Grey300}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" ClipToBounds="True"
                        DataContext="{Binding Header}" x:DataType="vm:DcpHeader">
              <!-- The RAI form's own terms, the same in every language -->
              <StackPanel Spacing="2" MaxWidth="320">
                <TextBlock Classes="label" Text="Programma" />
                <TextBlock Text="{Binding Programme}" FontSize="16" FontWeight="SemiBold" Height="30" LineHeight="30"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitoloItaliano}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="Puntata" ToolTip.Tip="{l:Tr Info_Puntata}" />
                <TextBox Classes="strip" Width="64" Text="{Binding Puntata, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="Puntata" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="Data trasmissione" ToolTip.Tip="{l:Tr Info_DataTrasmissione}" />
                <TextBox x:Name="BroadcastDateBox" Classes="strip" Width="124" Text="{Binding DataTrasmissione, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="{l:Tr Strip_DatePlaceholder}" AutomationProperties.Name="Data trasmissione" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="Durata" ToolTip.Tip="{l:Tr Info_Durata}" />
                <TextBox Classes="strip" Width="80" Text="{Binding Durata, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="{l:Tr Strip_DurationPlaceholder}" AutomationProperties.Name="Durata" />
              </StackPanel>
              <Button Classes="ghost stripToggle" Height="30" Padding="8,0,6,0" VerticalAlignment="Bottom" Margin="-4,0,0,0"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleStripCommand}"
                      Classes.expanded="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsStripExpanded}"
                      Foreground="{StaticResource Grey900}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Panel>
                    <TextBlock Text="{l:Tr Strip_AllFields}" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsStripExpanded}" />
                    <TextBlock Text="{l:Tr Strip_FewerFields}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsStripExpanded}" />
                  </Panel>
                  <c:LineIcon Data="{StaticResource Icon.ChevronDown}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Button Grid.Column="3" Classes="primary" Height="32" Padding="12,0" IsVisible="{Binding UpdateReady}"
                    Content="{l:Tr Update_Restart}" Command="{Binding RestartForUpdateCommand}" />

            <!-- Speichern / Speichern unter… as one split button -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Classes="secondary splitMain" Command="{Binding SaveCommand}" ToolTip.Tip="{l:Tr Save_Tip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LineIcon Data="{StaticResource Icon.Save}" />
                  <TextBlock Text="{l:Tr Save_Button}" />
                </StackPanel>
              </Button>
              <Button x:Name="SaveMoreButton" Classes="secondary splitMore" AutomationProperties.Name="{l:Tr Save_More}" ToolTip.Tip="{l:Tr Save_More}">
                <c:LineIcon Data="{StaticResource Icon.ChevronDown}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- All fields of the programme, folded out -->
        <Border Grid.Row="1" IsVisible="{Binding IsStripExpanded}" Background="{StaticResource Grey50}"
                BorderBrush="{StaticResource Grey300}" BorderThickness="0,0,0,1" Padding="16,14,16,18">
          <WrapPanel x:Name="FieldsPanel" ItemSpacing="16" LineSpacing="10" DataContext="{Binding Header}" x:DataType="vm:DcpHeader">
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Titolo italiano" Info="{l:Tr Info_TitoloItaliano}" />
              <TextBox Classes="field" Text="{Binding TitoloItaliano, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Titolo italiano" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Titolo originale" Info="{l:Tr Info_TitoloOriginale}" />
              <TextBox Classes="field" Text="{Binding TitoloOriginale, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Sottotitolo" Info="{l:Tr Info_Sottotitolo}" />
              <TextBox Classes="field" Text="{Binding Sottotitolo, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Serie" Info="{l:Tr Info_Serie}" />
              <TextBox Classes="field" Text="{Binding Serie, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Data registrazione" Info="{l:Tr Info_DataRegistrazione}" />
              <TextBox Classes="field" Text="{Binding DataRegistrazione, UpdateSourceTrigger=LostFocus}" PlaceholderText="{l:Tr Strip_RegistrazionePlaceholder}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Ora inizio" Info="{l:Tr Info_OraInizio}" />
              <TextBox Classes="field" Text="{Binding OraInizio, UpdateSourceTrigger=LostFocus}" PlaceholderText="hh:mm:ss" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Sede" Info="{l:Tr Info_Sede}" />
              <ComboBox ItemsSource="{Binding Sedi}" SelectedItem="{Binding SedeEntry}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Rete" Info="{l:Tr Info_Rete}" />
              <ComboBox ItemsSource="{Binding Reti}" SelectedItem="{Binding ReteEntry}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Uorg" Info="{l:Tr Info_UorgMatricola}" />
              <TextBox Classes="field" Text="{Binding Uorg, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Matricola" Info="{l:Tr Info_UorgMatricola}" />
              <TextBox Classes="field" Text="{Binding Matricola, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Numero contratto" Info="{l:Tr Info_FormOnly}" />
              <TextBox Classes="field" Text="{Binding NumeroContratto, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Data contratto" Info="{l:Tr Info_FormOnly}" />
              <TextBox Classes="field" Text="{Binding DataContratto, UpdateSourceTrigger=LostFocus}" PlaceholderText="{l:Tr Strip_DatePlaceholder}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <v:FieldLabel Text="Responsabile RAI" Info="{l:Tr Info_FormOnly}" />
              <TextBox Classes="field" Text="{Binding ResponsabileRai, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- The middle: the songs (step 3), or the guide, the export page or the settings in their place -->
        <Panel Grid.Row="2">
          <v:SongsView x:Name="Songs" IsVisible="{Binding IsSongsPage}" />
          <v:GuideView IsVisible="{Binding IsGuidePage}" />
          <v:ExportView IsVisible="{Binding IsExportPage}" />
          <v:SettingsView IsVisible="{Binding IsSettingsPage}" />
          <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Top" IsVisible="{Binding IsBusy}"
                       Foreground="{StaticResource Accent}" Background="Transparent" />
        </Panel>

        <!-- Step 2 and step 4: two fixed areas. The open step is a tab of the white sheet. -->
        <Grid Grid.Row="3" Height="185">
          <c:StepSheet OpenStep="{Binding OpenStep}" Ground="{StaticResource Grey150}" Sheet="{StaticResource Sheet}" Line="{StaticResource Grey300}" />
          <Grid ColumnDefinitions="*,*">
            <!-- Add -->
            <Panel Grid.Column="0" Margin="12,13,12,24" Classes="addCard" Classes.current="{Binding IsAddStep}">
              <Rectangle Classes="addFrame" IsVisible="{Binding !IsDraggingSongs}" />
              <Rectangle Classes="dropFrame" IsVisible="{Binding IsDraggingSongs}" />
              <Button Classes="plain" CornerRadius="10" Command="{Binding GoSongsCommand}" Cursor="Hand"
                      AutomationProperties.Name="{l:Tr Area_ToSongs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              <!-- Centred in height with 2 px on top: 14 px from the top like the Export area, and room for a notice of two lines -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,2,16,0">
                <Panel Width="48" Height="48" HorizontalAlignment="Center" IsHitTestVisible="False">
                  <c:LineIcon Classes="areaIcon" Width="48" Height="48" StrokeThickness="1.75" Data="{StaticResource Icon.Plus}"
                              IsVisible="{Binding IsAddIdle}" />
                  <c:LineIcon Classes="areaIcon" Width="48" Height="48" StrokeThickness="1.75" Data="{StaticResource Icon.Plus}"
                              IsVisible="{Binding IsAddImporting}" />
                  <c:LineIcon Width="48" Height="48" StrokeThickness="1.75" Data="{StaticResource Icon.Check}"
                              Foreground="{StaticResource AccentText}" IsVisible="{Binding IsAddAdded}" />
                  <c:LineIcon Width="48" Height="48" StrokeThickness="1.75" Data="{StaticResource Icon.Alert}"
                              Foreground="{StaticResource Grey900}" IsVisible="{Binding IsAddPartial}" />
                  <c:LineIcon Width="48" Height="48" StrokeThickness="1.75" Data="{StaticResource Icon.Download}"
                              Foreground="{StaticResource AccentText}" IsVisible="{Binding IsDraggingSongs}" />
                </Panel>
                <Panel MinHeight="20" Margin="0,6,0,12" HorizontalAlignment="Center">
                  <TextBlock Text="{l:Tr Add_DropTitle}" FontSize="15" FontWeight="SemiBold" IsVisible="{Binding IsAddIdle}" IsHitTestVisible="False" />
                  <TextBlock Text="{Binding AddNotice}" FontSize="15" FontWeight="SemiBold" IsVisible="{Binding IsAddImporting}" IsHitTestVisible="False" />
                  <!-- The notice wraps to two lines within the area; Rückgängig / Warum? always keeps its place on the right -->
                  <DockPanel HorizontalAlignment="Center" IsVisible="{Binding IsAddAdded}">
                    <Button DockPanel.Dock="Right" Classes="link" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding UndoImportCommand}">
                      <TextBlock Text="{l:Tr Add_Undo}" FontSize="14" />
                    </Button>
                    <!-- The tip sits on a panel: on the text block it would inherit its trimming -->
                    <Panel Background="Transparent" ToolTip.Tip="{Binding AddNoticeTip}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding AddNotice}" FontSize="15" FontWeight="SemiBold" LineHeight="19"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="440" />
                    </Panel>
                  </DockPanel>
                  <DockPanel HorizontalAlignment="Center" IsVisible="{Binding IsAddPartial}">
                    <Button DockPanel.Dock="Right" Classes="link" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenImportHelpCommand}">
                      <TextBlock Text="{l:Tr Add_Why}" FontSize="14" />
                    </Button>
                    <!-- The tip sits on a panel: on the text block it would inherit its trimming -->
                    <Panel Background="Transparent" ToolTip.Tip="{Binding AddNoticeTip}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding AddNotice}" FontSize="15" FontWeight="SemiBold" LineHeight="19"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="440" />
                    </Panel>
                  </DockPanel>
                  <TextBlock Text="{l:Tr Add_Release}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"
                             IsVisible="{Binding IsDraggingSongs}" IsHitTestVisible="False" />
                </Panel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding ShowAddButtons}">
                  <Button Classes="secondary" Content="{l:Tr Add_Pick}" Command="{Binding AddMusicFilesCommand}" />
                  <Button Classes="howto" Classes.active="{Binding IsGuidePage}" Command="{Binding ToggleGuideCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:LineIcon Data="{StaticResource Icon.Help}" />
                      <TextBlock Text="{l:Tr Add_How}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Panel>

            <!-- Export or upload -->
            <Button Grid.Column="1" Margin="12,13,12,24" Classes="plain exportCard" Classes.current="{Binding IsExportStep}"
                    Command="{Binding GoExportCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Top">
              <StackPanel Margin="16,14,16,0" HorizontalAlignment="Center">
                <c:LineIcon Classes="areaIcon" Width="48" Height="48" StrokeThickness="1.75" Data="{StaticResource Icon.ToExport}" />
                <TextBlock Margin="0,6,0,0" Height="20" Text="{l:Tr Area_ExportTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ExportAreaSubtitle}" FontSize="13" Foreground="{StaticResource Grey600}"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- A .dcp dragged over the window: release to open it -->
    <Border IsVisible="{Binding IsDraggingDcp}" Background="#E6F6F8FA" Padding="24">
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Sheet}" CornerRadius="14"
              BoxShadow="0 16 40 0 #2414171D">
        <Panel>
          <Rectangle Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="3,2" RadiusX="14" RadiusY="14" />
          <StackPanel Margin="32,36" Spacing="10" HorizontalAlignment="Center">
            <c:LineIcon Width="32" Height="32" StrokeThickness="1.75" Data="{StaticResource Icon.File}" Foreground="{StaticResource AccentText}"
                        HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Open_Release}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding DraggedDcpName}" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{l:Tr Open_Note}" Classes="secondary" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Panel>
      </Border>
    </Border>
  </Panel>
</Window>
