<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:DcpTool.App.Views.Controls"
             x:Class="DcpTool.App.App"
             RequestedThemeVariant="Light">
  <!-- The look of the design "DCP Tool · plan and wireframes" (board "Styles to copy"): one grey ramp with the
       accent's cool hue and one accent. Ordinary Fluent controls, restyled; the bottom areas are the only custom part. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Sheet" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Grey50" Color="#F6F8FA" />
    <SolidColorBrush x:Key="Grey100" Color="#EFF1F4" />
    <SolidColorBrush x:Key="Grey150" Color="#E6EAEE" />
    <SolidColorBrush x:Key="Grey200" Color="#DCE0E6" />
    <SolidColorBrush x:Key="Grey300" Color="#BCC1C9" />
    <SolidColorBrush x:Key="Grey400" Color="#8A919B" />
    <SolidColorBrush x:Key="Grey500" Color="#5A616B" />
    <SolidColorBrush x:Key="Grey600" Color="#4B525B" />
    <SolidColorBrush x:Key="Grey700" Color="#363C45" />
    <SolidColorBrush x:Key="Grey800" Color="#252B32" />
    <SolidColorBrush x:Key="Grey900" Color="#14171D" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#2157CF" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1C4AB0" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF3FD" />
    <SolidColorBrush x:Key="AccentDrop" Color="#D8E3FB" />
    <SolidColorBrush x:Key="AccentText" Color="#2157CF" />
    <SolidColorBrush x:Key="AccentRing" Color="#B3CAF7" />
    <SolidColorBrush x:Key="ErrorText" Color="#B42318" />
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Menlo,monospace</FontFamily>

    <!-- Focus: a 2 px accent ring with a white gap, everywhere -->
    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF" />

    <!-- The songs table: tinted header, grey 200 lines, grey 100 selection, grey 50 hover -->
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="#4B525B" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#DCE0E6" />
    <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridCellBackgroundBrush" Color="Transparent" />
    <Color x:Key="DataGridRowHoveredBackgroundColor">#F6F8FA</Color>
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#EFF1F4" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#EFF1F4" />
    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#EFF1F4" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#EFF1F4" />
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent" />
    <!-- The table is never sorted: no room kept for a sort arrow in the headers -->
    <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

    <!-- Icons: 24-unit outline paths (Lucide), drawn by LineIcon with round caps -->
    <StreamGeometry x:Key="Icon.ChevronDown">M6 9L12 15L18 9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M5 12H19M12 5V19</StreamGeometry>
    <StreamGeometry x:Key="Icon.More">M12 11A1 1 0 1 0 12 13A1 1 0 1 0 12 11Z M19 11A1 1 0 1 0 19 13A1 1 0 1 0 19 11Z M5 11A1 1 0 1 0 5 13A1 1 0 1 0 5 11Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.FolderOpen">M6 14L7.5 11.1A2 2 0 0 1 9.24 10H20A2 2 0 0 1 21.94 12.5L20.4 18.5A2 2 0 0 1 18.45 20H4A2 2 0 0 1 2 18V5A2 2 0 0 1 4 3H7.9A2 2 0 0 1 9.59 3.9L10.4 5.1A2 2 0 0 0 12.07 6H18A2 2 0 0 1 20 8V10</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M12.22 2H11.78A2 2 0 0 0 9.78 4V4.18A2 2 0 0 1 8.78 5.91L8.35 6.16A2 2 0 0 1 6.35 6.16L6.2 6.08A2 2 0 0 0 3.47 6.81L3.25 7.19A2 2 0 0 0 3.98 9.92L4.13 10.02A2 2 0 0 1 5.13 11.74V12.25A2 2 0 0 1 4.13 13.99L3.98 14.08A2 2 0 0 0 3.25 16.81L3.47 17.19A2 2 0 0 0 6.2 17.92L6.35 17.84A2 2 0 0 1 8.35 17.84L8.78 18.09A2 2 0 0 1 9.78 19.82V20A2 2 0 0 0 11.78 22H12.22A2 2 0 0 0 14.22 20V19.82A2 2 0 0 1 15.22 18.09L15.65 17.84A2 2 0 0 1 17.65 17.84L17.8 17.92A2 2 0 0 0 20.53 17.19L20.75 16.8A2 2 0 0 0 20.02 14.07L19.87 13.99A2 2 0 0 1 18.87 12.25V11.75A2 2 0 0 1 19.87 10.01L20.02 9.92A2 2 0 0 0 20.75 7.19L20.53 6.81A2 2 0 0 0 17.8 6.08L17.65 6.16A2 2 0 0 1 15.65 6.16L15.22 5.91A2 2 0 0 1 14.22 4.18V4A2 2 0 0 0 12.22 2Z M12 9A3 3 0 1 0 12 15A3 3 0 1 0 12 9Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.PanelLeft">M5 3H19A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3Z M9 3V21</StreamGeometry>
    <StreamGeometry x:Key="Icon.Save">M15.2 3A2 2 0 0 1 16.6 3.6L20.4 7.4A2 2 0 0 1 21 8.8V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3Z M17 21V14A1 1 0 0 0 16 13H8A1 1 0 0 0 7 14V21 M7 3V7A1 1 0 0 0 8 8H15</StreamGeometry>
    <StreamGeometry x:Key="Icon.Help">M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2Z M9.09 9A3 3 0 0 1 14.92 10C14.92 12 11.92 13 11.92 13 M12 17H12.01</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M18 6L6 18M6 6L18 18</StreamGeometry>
    <StreamGeometry x:Key="Icon.CheckCircle">M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2Z M9 12L11 14L15 10</StreamGeometry>
    <StreamGeometry x:Key="Icon.Alert">M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2Z M12 8V12 M12 16H12.01</StreamGeometry>
    <StreamGeometry x:Key="Icon.Upload">M21 15V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V15 M17 8L12 3L7 8 M12 3V15</StreamGeometry>
    <StreamGeometry x:Key="Icon.Download">M21 15V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V15 M7 10L12 15L17 10 M12 15V3</StreamGeometry>
    <StreamGeometry x:Key="Icon.External">M15 3H21V9 M10 14L21 3 M18 13V19A2 2 0 0 1 16 21H5A2 2 0 0 1 3 19V8A2 2 0 0 1 5 6H11</StreamGeometry>
    <StreamGeometry x:Key="Icon.Copy">M10 8H20A2 2 0 0 1 22 10V20A2 2 0 0 1 20 22H10A2 2 0 0 1 8 20V10A2 2 0 0 1 10 8Z M4 16C2.9 16 2 15.1 2 14V4C2 2.9 2.9 2 4 2H14C15.1 2 16 2.9 16 4</StreamGeometry>
    <StreamGeometry x:Key="Icon.FileText">M15 2H6A2 2 0 0 0 4 4V20A2 2 0 0 0 6 22H18A2 2 0 0 0 20 20V7Z M14 2V6A2 2 0 0 0 16 8H20 M10 9H8 M16 13H8 M16 17H8</StreamGeometry>
    <StreamGeometry x:Key="Icon.File">M15 2H6A2 2 0 0 0 4 4V20A2 2 0 0 0 6 22H18A2 2 0 0 0 20 20V7Z M14 2V6A2 2 0 0 0 16 8H20</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M20 6L9 17L4 12</StreamGeometry>
    <StreamGeometry x:Key="Icon.ToExport">M3 5V19 M21 12H7 M15 18L21 12L15 6</StreamGeometry>
    <StreamGeometry x:Key="Icon.ArrowLeft">M12 19L5 12L12 5 M19 12H5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Image">M5 3H19A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3Z M9 7A2 2 0 1 0 9 11A2 2 0 1 0 9 7Z M21 15L17.9 11.9A2 2 0 0 0 15.1 11.9L6 21</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2563EB" RegionColor="#FFFFFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>

    <Style Selector="c|LineIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- ===================================================== text -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Grey600}" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Grey500}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Grey600}" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{StaticResource Grey500}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Grey700}" />
    </Style>

    <!-- ===================================================== buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- Secondary: white, grey 300 border -->
    <Style Selector="Button.secondary, Button.primary, Button.howto">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey300}" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey50}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey200}" />
      <Setter Property="Foreground" Value="{StaticResource Grey400}" />
    </Style>
    <Style Selector="Button.secondary.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>

    <!-- Primary: one per page -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey200}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey200}" />
      <Setter Property="Foreground" Value="{StaticResource Grey500}" />
    </Style>

    <!-- Accent outline: only "Wie?" -->
    <Style Selector="Button.howto">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,0,16,0" />
    </Style>
    <Style Selector="Button.howto:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>
    <Style Selector="Button.howto.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Ghost: quiet actions -->
    <Style Selector="Button.ghost, Button.icon, ToggleButton.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Grey700}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.ghost.small">
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey200}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Grey400}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Grey700}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>
    <Style Selector="Button.icon.open /template/ ContentPresenter#PART_ContentPresenter, Button.ghost.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey200}" />
    </Style>

    <!-- Underlined text in a line of text: Rückgängig, Warum?, Im Ordner zeigen -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>

    <!-- A button drawn by its own Border: drawer items, the export area, segmented choices -->
    <Style Selector="Button.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Drawer items: rest transparent, hover grey 100, current white + semibold + soft shadow. No accent in the drawer. -->
    <Style Selector="Button.drawer">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.drawer:pointerover">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>
    <Style Selector="Button.drawer.hovered">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>
    <Style Selector="Button.drawer.current">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.drawer.current /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="0 1 2 0 #1F14171D" />
    </Style>
    <Style Selector="Button.drawer.header">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Grey700}" />
    </Style>

    <!-- The small square buttons in the drawer (+, ⋯) -->
    <Style Selector="Button.mini">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Grey700}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mini.boxed">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey300}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>
    <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey200}" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>
    <Style Selector="Button.mini.boxed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Grey50}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
    </Style>

    <!-- ===================================================== inputs: grey 300 border, accent ring on focus -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey300}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #B3CAF7" />
    </Style>
    <Style Selector="TextBox:readonly /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Grey50}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="TextBox.strip">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey300}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey400}" />
    </Style>

    <!-- ===================================================== menus and popups -->
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey300}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="240" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Grey900}" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource Grey100}" />
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{StaticResource Grey500}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="FlyoutPresenter.popup">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Grey200}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,12,12,14" />
      <Setter Property="MaxWidth" Value="340" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{StaticResource Grey900}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="9,5" />
    </Style>

    <!-- ===================================================== the songs table -->
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="40" />
      <Setter Property="ColumnHeaderHeight" Value="48" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Grey200}" />
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Grey600}" />
      <Setter Property="Background" Value="{StaticResource Grey50}" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,8,4,0" />
      <Setter Property="AreSeparatorsVisible" Value="False" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="DataGridCell > TextBlock">
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Editing: a 2 px accent outline on the one cell -->
    <Style Selector="DataGridCell TextBox">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="4,4" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="DataGridCell TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="DataGridCell ComboBox">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="4,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ===================================================== misc -->
    <Style Selector="Separator.line">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="{StaticResource Grey200}" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>
  </Application.Styles>
</Application>
